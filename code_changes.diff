+// AddBulk appends multiple new commands to storage
+func (s *Storage) AddBulk(texts []string) (int, error) {
+	commands, err := s.Load()
+	if err != nil {
+		return 0, err
+	}
+
+	existing := make(map[string]bool)
+	for _, cmd := range commands {
+		existing[cmd.Text] = true
+	}
+
+	var allUniqueCommands []Command
+	// Add existing commands
+	for _, cmd := range commands {
+		allUniqueCommands = append(allUniqueCommands, cmd)
+	}
+
+	// Add new commands, ensuring uniqueness
+	initialUniqueCount := len(allUniqueCommands)
+	for _, text := range texts {
+		if _, found := existing[text]; !found {
+			allUniqueCommands = append(allUniqueCommands, Command{
+				Text:      text,
+				CreatedAt: time.Now(),
+				UseCount:  0,
+			})
+			existing[text] = true // Mark as seen for future checks within the same bulk add
+		}
+	}
+
+	// If no new unique commands were actually added, return immediately
+	if len(allUniqueCommands) == initialUniqueCount {
+		return 0, nil
+	}
+
+	if err := s.Save(allUniqueCommands); err != nil {
+		return 0, err
+	}
+
+	return len(allUniqueCommands) - initialUniqueCount, nil
+}
